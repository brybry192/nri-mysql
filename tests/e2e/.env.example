# ── New Relic ────────────────────────────────────────────────────────────────
# Prefer setting NR_LICENSE_KEY as an environment variable rather than in this
# file. Export it in your shell profile or CI secrets:
#   export NR_LICENSE_KEY=your_license_key_here
#
# Setting it here is insecure — use only as a last resort for local testing.
# This file should NOT be committed with real credentials (gitignored).
# NR_LICENSE_KEY=your_license_key_here

# Optional: override the New Relic region endpoint (default is US).
# NRIA_COLLECTOR_URL=https://infra-api.eu.newrelic.com

# ── Local MySQL ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=e2e_test_password
MYSQL_DATABASE=demo
MYSQL_USER=e2e_user
MYSQL_PASSWORD=e2e_test_password

# ── RDS / Aurora MySQL (only needed for remote testing) ─────────────────────
# RDS_HOST=your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
# RDS_PORT=3306
# RDS_USER=your_db_user
# RDS_PASSWORD=your_db_password
# RDS_DB=mysql
# RDS_ENABLE_TLS=true
